    <string name="find_it">Find it</string>
    <string name="find_it_title">Walk around and follow the number. Higher = closer.</string>
    <string name="find_waiting">Listening for it…</string>
    <string name="find_lost">Not heard for %1$d s. Go back to where it was stronger.</string>
