    <string name="section_radar">Radar</string>
    <string name="hint_radar">Icon = what it is, size = signal strength, rings = rough distance. Tap an icon for details, tap ⓘ to learn the icons. For direction, hold the phone flat against your chest and turn slowly in a full circle.</string>
    <string name="section_recent">Recently off radar</string>
    <string name="hint_recent">Flagged signals the radar can’t hear right now, from the last hour.</string>
    <string name="section_following">⚠ Possibly following you</string>
    <string name="hint_following">Same tag, away from its owner, with you %1$d min+ across %2$d places. Tap one to ignore it if it’s yours.</string>
    <string name="section_hits">Watchlist hits</string>
    <string name="hint_hits">Flock cameras, Axon gear, possible hidden cameras and anything you added, heard in the last hour.</string>
    <string name="section_spotted">Camera glasses</string>
    <string name="hint_spotted">Smart glasses that can record. Heard in the last 30 minutes.</string>
    <string name="section_cell">Cell network</string>
    <string name="hint_cell">Warning signs of a fake cell tower. A warning means look closer, not proof.</string>
    <string name="cell_waiting">Starts checking when you start listening.</string>
    <string name="section_trackers">Trackers nearby</string>
    <string name="hint_trackers">Item trackers heard in the last 15 minutes. Normal in crowds; only worry if one sticks with you.</string>
    <string name="section_others">Everything else</string>
    <string name="hint_others">Tap to see what they are.</string>
