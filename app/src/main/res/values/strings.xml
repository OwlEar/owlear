    <!-- Phone checkup (stalkerware signs on this phone) -->
    <string name="section_checkup">Phone checkup</string>
    <string name="hint_checkup">Looks for signs of stalkerware on this phone. It only runs when you tap Run, shows results only to you, and saves nothing.</string>
    <string name="state_on">On</string>
    <string name="state_off">Off</string>
    <string name="checkup_switch">Phone checkup</string>
    <string name="checkup_off_note">Tap to turn on. OwlEar will then be able to look at the list of apps on this phone, only when you run a checkup.</string>
    <string name="checkup_on_note">Tap to turn off. Turning it off also clears the last results.</string>
    <string name="checkup_parts">What to check (tap one to turn it on or off):</string>
    <string name="check_known">Known stalkerware</string>
    <string name="check_known_hint">Checks your apps against the names of %1$d known stalkerware apps. OwlEar only carries their names to look for, never the apps themselves. The name list is updated with each new version.</string>
    <string name="check_screen">Apps that can read your screen</string>
    <string name="check_screen_hint">Accessibility access lets an app see and tap anything on screen. Helpers like password managers use it too.</string>
    <string name="check_notif">Apps that can read your notifications</string>
    <string name="check_notif_hint">Notification access lets an app read your messages as they arrive.</string>
    <string name="check_admin">Apps with device admin</string>
    <string name="check_admin_hint">Device admin can lock the phone, wipe it, or make an app hard to uninstall.</string>
    <string name="check_hidden">Hidden apps</string>
    <string name="check_hidden_hint">Apps with powerful access but no icon on your home screen.</string>
    <string name="check_outside">Installed outside an app store</string>
    <string name="check_outside_hint">Stalkerware is usually installed by hand, not from an app store. Shown only next to another reason.</string>
    <string name="check_sensors">Camera, microphone and location</string>
    <string name="check_sensors_hint">Apps allowed all three at once. Shown only next to another reason, since maps and video calls need them too.</string>
    <string name="check_settings">Phone settings</string>
    <string name="check_settings_hint">USB debugging, developer options, and an active VPN or proxy.</string>
    <string name="checkup_run">Run checkup</string>
    <string name="checkup_running">Checking…</string>
    <string name="checkup_failed">The checkup couldn’t finish. Try again.</string>
    <string name="checkup_safety">Before you remove anything: if someone put stalkerware on your phone, they may notice when it stops reporting. If you might be in danger, make a safety plan first (see Get help below). OwlEar never removes or changes anything itself.</string>
    <string name="checkup_summary">Looked at %1$d apps. %2$d to look at.</string>
    <string name="checkup_clean">Nothing found by the checks you have on.</string>
    <string name="checkup_phone_setting">Phone setting</string>
    <string name="reason_known">Matches known stalkerware (%1$s)</string>
    <string name="reason_screen">can read your screen</string>
    <string name="reason_notif">can read your notifications</string>
    <string name="reason_admin">has device admin</string>
    <string name="reason_sensors">can use camera, microphone and location</string>
    <string name="reason_hidden">has no home-screen icon</string>
    <string name="reason_outside">installed outside an app store</string>
    <string name="setting_found_usb">USB debugging is on. Someone with a computer and your phone could install or control apps. Turn it off in Developer options if you didn’t turn it on.</string>
    <string name="setting_found_dev">Developer options are on. Fine if you turned them on; if not, someone else may have.</string>
    <string name="setting_found_vpn">A VPN is active. If you didn’t set one up, it could be routing your internet traffic through someone else.</string>
    <string name="setting_found_proxy">A proxy is set. If you didn’t set it, your internet traffic may be passing through someone else.</string>
    <string name="checkup_limits">A finding means look closer, not proof. Tap an app to open its App info, where you can remove its access or uninstall it when you’re ready. This checkup can’t catch government-grade spyware like Pegasus. For that, Amnesty International’s free MVT tool and Access Now’s Digital Security Helpline can help.</string>
    <string name="checkup_help">Get help</string>
    <string name="checkup_help_hint">Opens the Coalition Against Stalkerware’s list of hotlines and support, by country, in your browser.</string>
