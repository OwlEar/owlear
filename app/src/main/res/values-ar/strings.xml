    <!-- Phone checkup (stalkerware signs on this phone) -->
    <string name="section_checkup">فحص الهاتف</string>
    <string name="hint_checkup">يبحث عن علامات برامج التجسس على هذا الهاتف. لا يعمل إلا عندما تضغط «تشغيل»، ويعرض النتائج لك وحدك، ولا يحفظ شيئًا.</string>
    <string name="state_on">تشغيل</string>
    <string name="state_off">إيقاف</string>
    <string name="checkup_switch">فحص الهاتف</string>
    <string name="checkup_off_note">اضغط للتشغيل. سيتمكن OwlEar عندها من رؤية قائمة التطبيقات على هذا الهاتف، أثناء الفحص فقط.</string>
    <string name="checkup_on_note">اضغط للإيقاف. الإيقاف يمسح آخر النتائج أيضًا.</string>
    <string name="checkup_parts">ما الذي يُفحص (اضغط على أي بند لتشغيله أو إيقافه):</string>
    <string name="check_known">برامج تجسس معروفة</string>
    <string name="check_known_hint">يتحقق من تطبيقاتك مقابل أسماء %1$d تطبيق تجسس معروفًا. يحمل OwlEar أسماءها فقط للبحث عنها، وليس التطبيقات نفسها أبدًا. تُحدَّث قائمة الأسماء مع كل إصدار جديد.</string>
    <string name="check_screen">تطبيقات يمكنها قراءة شاشتك</string>
    <string name="check_screen_hint">إذن إمكانية الوصول يتيح للتطبيق رؤية كل ما على الشاشة والنقر عليه. تستخدمه أيضًا أدوات مساعدة مثل مديري كلمات المرور.</string>
    <string name="check_notif">تطبيقات يمكنها قراءة إشعاراتك</string>
    <string name="check_notif_hint">إذن الإشعارات يتيح للتطبيق قراءة رسائلك فور وصولها.</string>
    <string name="check_admin">تطبيقات لها صلاحية مشرف الجهاز</string>
    <string name="check_admin_hint">مشرف الجهاز يستطيع قفل الهاتف أو مسحه أو جعل إزالة التطبيق صعبة.</string>
    <string name="check_hidden">تطبيقات مخفية</string>
    <string name="check_hidden_hint">تطبيقات لها صلاحيات قوية لكن بلا أيقونة على الشاشة الرئيسية.</string>
    <string name="check_outside">مثبَّتة من خارج متجر التطبيقات</string>
    <string name="check_outside_hint">عادةً تُثبَّت برامج التجسس يدويًا لا من متجر. تظهر فقط مع سبب آخر.</string>
    <string name="check_sensors">الكاميرا والميكروفون والموقع</string>
    <string name="check_sensors_hint">تطبيقات مسموح لها بالثلاثة معًا. تظهر فقط مع سبب آخر، لأن الخرائط ومكالمات الفيديو تحتاجها أيضًا.</string>
    <string name="check_settings">إعدادات الهاتف</string>
    <string name="check_settings_hint">تصحيح أخطاء USB وخيارات المطوّرين وشبكة VPN أو وكيل نشط.</string>
    <string name="checkup_run">تشغيل الفحص</string>
    <string name="checkup_running">جارٍ الفحص…</string>
    <string name="checkup_failed">تعذّر إكمال الفحص. حاول مرة أخرى.</string>
    <string name="checkup_safety">قبل أن تزيل أي شيء: إذا وضع أحدهم برنامج تجسس على هاتفك، فقد يلاحظ عندما يتوقف عن إرسال المعلومات. إذا كنت قد تكون في خطر، ضع خطة أمان أولًا (انظر «اطلب المساعدة» أدناه). OwlEar لا يزيل ولا يغيّر أي شيء بنفسه أبدًا.</string>
    <string name="checkup_summary">تم فحص %1$d تطبيق. %2$d تستحق النظر.</string>
