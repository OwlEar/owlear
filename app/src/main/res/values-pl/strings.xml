<resources>
    <string name="app_tagline">Nasłuchuje ukrytych lokalizatorów, kamer Flock, dronów, okularów z kamerą, fałszywych stacji bazowych i sygnałów, które sam wybierzesz. Nic nigdy nie opuszcza tego telefonu.</string>
